{
  "info": {
    "name": "AlphaLedger",
    "description": "Calls through the API gateway. Run one of the Login requests first: it stores the access token in {{accessToken}}, which every other request sends as a Bearer token. Demo users and password are in infra/.env.example.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "demoPassword",
      "value": "Demo@AlphaLedger2026"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "tradeId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin (Anita)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"anita.admin@alphaledger.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login as PM (Priya)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.pm@alphaledger.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login as Ops Analyst (Rohan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan.ops@alphaledger.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login as Auditor (Vikram)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vikram.auditor@alphaledger.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "List users (Admin only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/users"
          }
        },
        {
          "name": "Create user (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.analyst@alphaledger.test\",\n  \"password\": \"Choose-A-Long-Password-1\",\n  \"fullName\": \"New Analyst\",\n  \"role\": \"OPS_ANALYST\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/users"
          }
        },
        {
          "name": "Logout (revoke refresh token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "No token (expect 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios"
          }
        }
      ]
    },
    {
      "name": "Portfolios",
      "item": [
        {
          "name": "List portfolios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "portfolios"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get portfolio 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/1"
          }
        },
        {
          "name": "Create portfolio (Admin or PM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AlphaLedger Postman Test Fund\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portfolios"
          }
        },
        {
          "name": "Add fund to portfolio 2 (Admin or managing PM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Infrastructure Debt Sleeve\",\n  \"assetClass\": \"REAL_ESTATE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/portfolios/2/funds"
          }
        }
      ]
    },
    {
      "name": "Instruments",
      "item": [
        {
          "name": "List instruments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/instruments"
          }
        },
        {
          "name": "Search by asset class (REAL_ESTATE)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/instruments?assetClass=REAL_ESTATE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "instruments"
              ],
              "query": [
                {
                  "key": "assetClass",
                  "value": "REAL_ESTATE"
                }
              ]
            }
          }
        },
        {
          "name": "Find by ISIN (Embassy REIT)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/instruments?isin=INE041025011",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "instruments"
              ],
              "query": [
                {
                  "key": "isin",
                  "value": "INE041025011"
                }
              ]
            }
          }
        },
        {
          "name": "Get instrument 18 (Reliance)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/instruments/18"
          }
        }
      ]
    },
    {
      "name": "Trades",
      "item": [
        {
          "name": "Capture trade (Admin or managing PM)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/trades",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolioId\": 2,\n  \"isin\": \"INE041025011\",\n  \"side\": \"BUY\",\n  \"quantity\": 500,\n  \"price\": 435.00\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tradeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "SELL above holding (stored as REJECTED)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/trades",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolioId\": 2,\n  \"isin\": \"INE041025011\",\n  \"side\": \"SELL\",\n  \"quantity\": 1000000,\n  \"price\": 435.00\n}"
            }
          }
        },
        {
          "name": "Blotter for portfolio 2",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/trades?portfolioId=2"
          }
        },
        {
          "name": "Get trade",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/trades/{{tradeId}}"
          }
        },
        {
          "name": "Trade audit trail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/trades/{{tradeId}}/audit"
          }
        },
        {
          "name": "Cancel trade (Admin or managing PM)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/trades/{{tradeId}}/cancel",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Booked by mistake\"\n}"
            }
          }
        },
        {
          "name": "Settle trade manually (Admin only)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/trades/{{tradeId}}/settle",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Confirmed with custodian\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Market data",
      "item": [
        {
          "name": "Latest prices (all instruments, with source badge)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/prices/latest"
          }
        },
        {
          "name": "Latest price: Embassy REIT",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/prices/latest?isin=INE041025011"
          }
        },
        {
          "name": "Latest price: synthetic Deccan Logistics (L3 mark)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/prices/latest?isin=ZZSYN0000001"
          }
        },
        {
          "name": "Price history: Reliance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/prices?isin=INE002A01018"
          }
        },
        {
          "name": "Ingestion log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/ingestions"
          }
        },
        {
          "name": "Run synthetic marks (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/marketdata/ingestions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"SYNTHETIC\"\n}"
            }
          }
        },
        {
          "name": "NSE holidays 2026",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/marketdata/holidays?year=2026"
          }
        }
      ]
    },
    {
      "name": "Positions",
      "item": [
        {
          "name": "Positions: Bharat Real Assets (portfolio 2)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/2/positions"
          }
        },
        {
          "name": "Positions incl. closed",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/3/positions?includeClosed=true"
          }
        },
        {
          "name": "Position snapshot for a date",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/2/positions/snapshots?date=2026-10-15"
          }
        },
        {
          "name": "Position exceptions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/2/positions/exceptions"
          }
        }
      ]
    },
    {
      "name": "Valuation",
      "item": [
        {
          "name": "Valuation (Market Value, P&L, price badges)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/2/valuation"
          }
        },
        {
          "name": "Exposure by asset class and instrument",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/3/exposure"
          }
        },
        {
          "name": "Valuation history (EOD snapshots)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/portfolios/2/valuation/history"
          }
        },
        {
          "name": "Limit rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/valuations/limit-rules"
          }
        },
        {
          "name": "Set limit rule (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/valuations/limit-rules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolioId\": 3,\n  \"assetClass\": \"PRIVATE_EQUITY\",\n  \"maxPct\": 60\n}"
            }
          }
        },
        {
          "name": "Run end-of-day valuation (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/valuations/eod-runs"
          }
        },
        {
          "name": "Limit breaches",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/valuations/limit-breaches"
          }
        }
      ]
    }
  ]
}