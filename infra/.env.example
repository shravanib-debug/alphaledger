# Copy to infra/.env (git-ignored) and adjust. Values here are local-development defaults only.
POSTGRES_USER=alphaledger
POSTGRES_PASSWORD=alphaledger
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
# Refresh-token cookie Secure flag: false only for the local plain-HTTP stack; keep true anywhere served over HTTPS.
AUTH_COOKIE_SECURE=false

# HMAC-SHA256 key for access tokens: Base64, at least 32 bytes. Generate your own with:
#   openssl rand -base64 48
# docker-compose.yml has a local-development default; never reuse it anywhere shared.
JWT_SECRET=

# Password for the four demo users (anita.admin, priya.pm, rohan.ops, vikram.auditor @alphaledger.test).
DEMO_USER_PASSWORD=Demo@AlphaLedger2026

# Grafana sign-in (monitoring profile).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
