# On the server: cp infra/production.env.example infra/.env, fill in every value, chmod 600 infra/.env.
# Generate each secret with: openssl rand -base64 48   (POSTGRES_PASSWORD: use openssl rand -hex 32)

# Public host name; its DNS A record must point at this server before the first start.
DOMAIN=
COMPOSE_PROFILES=recon,analytics,monitoring

POSTGRES_USER=alphaledger
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_USER_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# First-login accounts and sample portfolios. Set both to false only once real users exist.
SEED_DEMO_USERS=true
SEED_DEMO_DATA=true

# Optional real mail relay; the default sink keeps mail inside the server.
MAIL_HOST=mailhog
MAIL_PORT=1025
